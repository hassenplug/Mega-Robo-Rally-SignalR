<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cuts template tiles out of the board-photo eval cases (install/Boards/photos/eval-cases.json)
       and writes them to MRR.Config/wwwroot/images/real. See BOARD_PHOTO_IMPORT_DESIGN.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MRR.Config\MRR.Config.csproj" />
  </ItemGroup>

</Project>
