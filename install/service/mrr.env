# /etc/default/mrr - tunables for the MRR process manager.
# Sourced by mrr-server.service (as systemd EnvironmentFile) and by the helper
# scripts (as shell). Keep it to plain KEY=value with no expansion or quoting tricks.

# --- .NET runtime -----------------------------------------------------------
DOTNET_ROOT=/home/mrr/.dotnet
DOTNET_CLI_TELEMETRY_OPTOUT=1
DOTNET_NOLOGO=1
ASPNETCORE_ENVIRONMENT=Production

# Overrides "Urls" in appsettings.json (env config wins over appsettings).
ASPNETCORE_URLS=http://*:5000

# --- Layout -----------------------------------------------------------------
MRR_REPO=/home/mrr/Mega-Robo-Rally-SignalR
MRR_APP_DIR=/srv/mrr/app
MRR_DOTNET=/home/mrr/.dotnet/dotnet

# --- Preflight checks -------------------------------------------------------
MRR_DB_HOST=mrobopi
MRR_DB_PORT=3306
MRR_PORT=5000

# --- Health probe -----------------------------------------------------------
# Default is a static file: proves Kestrel is serving, with no side effects.
# NOT "/" - that returns 404 (UseDefaultFiles is registered after UseStaticFiles
# in Program.cs, so "/" is never rewritten to index.html).
# NOT /api/alldata - it broadcasts an AllDataUpdate to every connected phone.
# Switch to http://127.0.0.1:5000/api/health once that endpoint exists.
MRR_HEALTH_URL=http://127.0.0.1:5000/index.html
MRR_HEALTH_TIMEOUT=5
MRR_HEALTH_STRIKES=3
MRR_HEALTH_GRACE=60
