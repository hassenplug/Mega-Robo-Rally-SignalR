# /etc/default/mrr - tunables for the MRR process manager.
# Sourced by mrr-server.service and mrr-config.service (as systemd EnvironmentFile) and by
# the helper scripts (as shell). Keep it to plain KEY=value with no expansion or quoting
# tricks.

# --- .NET runtime -----------------------------------------------------------
DOTNET_ROOT=/home/mrr/.dotnet
DOTNET_CLI_TELEMETRY_OPTOUT=1
DOTNET_NOLOGO=1
ASPNETCORE_ENVIRONMENT=Production

# --- Layout -----------------------------------------------------------------
MRR_REPO=/home/mrr/Mega-Robo-Rally-SignalR
MRR_DOTNET=/home/mrr/.dotnet/dotnet

# --- Game host (mrr-server.service) -----------------------------------------
# Serves the phones, the GM panel, the SignalR hub and the robot WebSockets.
MRR_GAME_APP_DIR=/srv/mrr/game
MRR_GAME_PORT=5000
MRR_GAME_HEALTH_URL=http://127.0.0.1:5000/api/health

# --- Configuration and authoring host (mrr-config.service) ------------------
# Board editor. Reached directly at http://<host>:5001/ ; no reverse proxy, because
# everything phone-facing already shares the game host's origin.
MRR_CONFIG_APP_DIR=/srv/mrr/config
MRR_CONFIG_PORT=5001
MRR_CONFIG_HEALTH_URL=http://127.0.0.1:5001/api/health

# --- Database (shared) ------------------------------------------------------
MRR_DB_HOST=mrobopi
MRR_DB_PORT=3306

# --- Health probe -----------------------------------------------------------
MRR_HEALTH_TIMEOUT=5
MRR_HEALTH_STRIKES=3                 # consecutive failures before restart
MRR_HEALTH_GRACE=60                  # seconds after start before probing

# --- Compatibility aliases --------------------------------------------------
# Older scripts read the unprefixed names. They mean the game host. Remove once nothing
# references them.
MRR_APP_DIR=/srv/mrr/game
MRR_PORT=5000
MRR_HEALTH_URL=http://127.0.0.1:5000/api/health

# ASPNETCORE_URLS is deliberately NOT set here: it would apply to both units. Each host
# takes its listen URL from its own appsettings.json ("Urls").
