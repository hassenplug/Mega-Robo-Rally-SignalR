[Unit]
Description=MRR health probes (game host and config host)
Documentation=file:/home/mrr/Mega-Robo-Rally-SignalR/install/PROCESS_MANAGER.md

[Service]
Type=oneshot
EnvironmentFile=/etc/default/mrr
# One probe per host, each with its own strike file.
ExecStart=/usr/local/bin/mrr-health-check game
ExecStart=/usr/local/bin/mrr-health-check config
SyslogIdentifier=mrr-health
