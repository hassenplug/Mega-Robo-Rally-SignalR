#!/bin/bash
# mrrctl - operator CLI for the Mega Robo Rally process manager.
# Thin, opinionated wrapper over systemctl. See install/PROCESS_MANAGER.md.
set -uo pipefail

[ -r /etc/default/mrr ] && . /etc/default/mrr

TARGET=mrr.target
MAIN=mrr-server.service
GAME=mrr-server.service
CONFIG=mrr-config.service
BOOT_UNITS=(mrr-server.service mrr-config.service mrr-health.timer mrr-recover.timer)

REPO="${MRR_REPO:-/home/mrr/Mega-Robo-Rally-SignalR}"
GAME_APP_DIR="${MRR_GAME_APP_DIR:-${MRR_APP_DIR:-/srv/mrr/game}}"
CONFIG_APP_DIR="${MRR_CONFIG_APP_DIR:-/srv/mrr/config}"
APP_DIR="$GAME_APP_DIR"   # back-compat for anything still reading APP_DIR
DOTNET="${MRR_DOTNET:-/home/mrr/.dotnet/dotnet}"
RUN_USER="${MRR_USER:-mrr}"
SYSTEMCTL=/usr/bin/systemctl

die()  { echo "mrrctl: $*" >&2; exit 1; }
info() { echo "==> $*"; }

sc() {
    if [ "$(id -u)" -eq 0 ]; then "$SYSTEMCTL" "$@"; else sudo "$SYSTEMCTL" "$@"; fi
}

# Resolve a shorthand to one or more units.
#
# A bare verb means THE GAME HOST, not the whole group. Restarting the board editor
# because you restarted the game is harmless; restarting the game because you wanted to
# reload the editor loses a turn. Use "all" to act on both. See PROCESS_MANAGER.md 10.1.
resolve_many() {
    local name="${1:-}"
    case "$name" in
        "")             echo "$GAME" ;;
        all|both)       echo "$GAME $CONFIG" ;;
        game|server)    echo "$GAME" ;;
        config|editor)  echo "$CONFIG" ;;
        target)         echo "$TARGET" ;;
        *.service|*.timer|*.target) echo "$name" ;;
        health)         echo "mrr-health.timer" ;;
        recover)        echo "mrr-recover.timer" ;;
        mrr-*)          echo "${name}.service" ;;
        *)              echo "mrr-${name}.service" ;;
    esac
}

resolve() { resolve_many "${1:-}" | awk '{print $1}'; }

# pause/resume operate on a single service, never on the target
resolve_service() {
    local u; u=$(resolve "${1:-}")
    [ "$u" = "$TARGET" ] && u="$MAIN"
    echo "$u"
}

cmd_status() {
    local unit; unit=$(resolve_service "${1:-}")
    local state sub freezer pid mem since
    state=$("$SYSTEMCTL" show -p ActiveState  --value "$unit")
    sub=$("$SYSTEMCTL"   show -p SubState     --value "$unit")
    freezer=$("$SYSTEMCTL" show -p FreezerState --value "$unit")
    pid=$("$SYSTEMCTL"   show -p MainPID      --value "$unit")
    mem=$("$SYSTEMCTL"   show -p MemoryCurrent --value "$unit")
    since=$("$SYSTEMCTL" show -p ActiveEnterTimestamp --value "$unit")

    echo "unit      : $unit"
    echo "state     : $state ($sub)"
    [ "$freezer" = "running" ] || echo "PAUSED    : freezer=$freezer   (mrrctl resume)"
    echo "boot      : $("$SYSTEMCTL" is-enabled "$TARGET" 2>/dev/null) ($TARGET)"
    [ "$pid" != "0" ] && echo "pid       : $pid"
    [ -n "$since" ]   && echo "since     : $since"
    if [[ "$mem" =~ ^[0-9]+$ ]]; then
        echo "memory    : $(( mem / 1024 / 1024 )) MB"
    fi
    local role url strikes
    case "$unit" in
        "$CONFIG") role=config; url="${MRR_CONFIG_HEALTH_URL:-http://127.0.0.1:5001/api/health}" ;;
        *)         role=game;   url="${MRR_GAME_HEALTH_URL:-${MRR_HEALTH_URL:-http://127.0.0.1:5000/api/health}}" ;;
    esac
    echo "health    : $url"
    if curl -fsS -o /dev/null --max-time 3 "$url" 2>/dev/null; then
        echo "probe     : OK"
    else
        echo "probe     : NOT RESPONDING"
    fi
    strikes="/run/mrr/health.${role}.strikes"
    [ -f "$strikes" ] && echo "strikes   : $(cat "$strikes")"

    if [ "$role" = config ]; then
        if [ -f "$CONFIG_APP_DIR/MRR.Config.dll" ]; then
            echo "deployed  : $CONFIG_APP_DIR  ($(date -r "$CONFIG_APP_DIR/MRR.Config.dll" '+%Y-%m-%d %H:%M'))"
        else
            echo "deployed  : MISSING - run 'mrrctl deploy config'"
        fi
    else
        if [ -f "$GAME_APP_DIR/MRR.dll" ]; then
            echo "deployed  : $GAME_APP_DIR  ($(date -r "$GAME_APP_DIR/MRR.dll" '+%Y-%m-%d %H:%M'))"
        else
            echo "deployed  : MISSING - run 'mrrctl deploy game'"
        fi
    fi

    # A bare "mrrctl status" should still show that the other host exists.
    if [ -z "${1:-}" ]; then
        echo
        echo "config    : $("$SYSTEMCTL" show -p ActiveState --value "$CONFIG") ($CONFIG)  -  'mrrctl status config'"
    fi
}

cmd_start() {
    for u in $(resolve_many "${1:-}"); do info "starting $u"; sc start "$u"; done
}
cmd_stop() {
    # Units are enumerated rather than relying on target propagation: mrr-config is
    # deliberately not PartOf=mrr.target, so stopping the target would leave it running.
    for u in $(resolve_many "${1:-}"); do
        info "stopping $u (stays down until 'mrrctl start')"; sc stop "$u"
    done
}
cmd_restart() {
    for u in $(resolve_many "${1:-}"); do info "restarting $u"; sc restart "$u"; done
}

cmd_pause() {
    local u; u=$(resolve_service "${1:-}")
    [ "$("$SYSTEMCTL" is-active "$u")" = "active" ] || die "$u is not running"
    info "freezing $u - connected phones will show 'reconnecting' until resume"
    sc freeze "$u"
}

cmd_resume() {
    local u; u=$(resolve_service "${1:-}")
    info "thawing $u"
    sc thaw "$u"
}

cmd_logs() {
    local follow=()
    [ "${1:-}" = "-f" ] && { follow=(-f); shift; }
    journalctl "${follow[@]}" -u 'mrr-*' -n "${1:-200}" --no-pager
}

cmd_enable() {
    for u in "$TARGET" "${BOOT_UNITS[@]}"; do sc enable "$u"; done
    info "MRR will start at boot"
}

cmd_disable() {
    for u in "${BOOT_UNITS[@]}" "$TARGET"; do sc disable "$u"; done
    info "MRR will NOT start at boot"
}

cmd_list() {
    "$SYSTEMCTL" list-units --all 'mrr*' --no-pager
    echo
    "$SYSTEMCTL" list-timers 'mrr-*' --no-pager
}

# Per-role deploy. Each host publishes to its own directory and keeps its own previous
# build, so a bad editor deploy never forces a game rollback -- independent deploy is one
# of the few things a separate process actually buys. See PROCESS_MANAGER.md 10.1.
role_paths() {
    case "$1" in
        game)   echo "$GAME_APP_DIR|MRR.dll|$REPO/MRR/MRR.csproj|$GAME" ;;
        config) echo "$CONFIG_APP_DIR|MRR.Config.dll|$REPO/MRR.Config/MRR.Config.csproj|$CONFIG" ;;
        *)      die "unknown role '$1' (expected game, config or all)" ;;
    esac
}

deploy_one() {
    local role="$1" paths dir dll proj unit prev stage was_active=no
    paths=$(role_paths "$role")
    dir=${paths%%|*};  paths=${paths#*|}
    dll=${paths%%|*};  paths=${paths#*|}
    proj=${paths%%|*}; unit=${paths#*|}
    prev="${dir}.previous"
    stage="${dir}.staging"

    [ -f "$proj" ] || die "project not found: $proj"
    [ -w "$(dirname "$dir")" ] || die "$(dirname "$dir") not writable by $(id -un)"

    [ "$("$SYSTEMCTL" is-active "$unit")" = "active" ] && was_active=yes

    info "[$role] publishing (Release) -> $stage"
    rm -rf "$stage"
    "$DOTNET" publish "$proj" -c Release -o "$stage" --nologo \
        || die "[$role] publish failed - nothing was changed"
    [ -f "$stage/$dll" ] || die "[$role] publish produced no $dll - nothing was changed"

    if [ "$was_active" = yes ]; then
        info "[$role] stopping $unit for swap"
        sc stop "$unit"
    fi

    if [ -d "$dir" ] && [ -f "$dir/$dll" ]; then
        info "[$role] keeping previous build in $prev"
        rm -rf "$prev"
        cp -a "$dir" "$prev"
    fi

    info "[$role] installing -> $dir"
    mkdir -p "$dir"
    # 'images/' holds camera captures written at runtime by the game host; never wipe them.
    rsync -a --delete --exclude 'images/' "$stage/" "$dir/"
    [ "$role" = game ] && mkdir -p "$dir/images/align"
    rm -rf "$stage"
    [ "$(id -u)" -eq 0 ] && chown -R "$RUN_USER":"$RUN_USER" "$dir" "$prev" 2>/dev/null

    if [ "$was_active" = yes ]; then
        info "[$role] starting $unit"
        sc start "$unit"
    fi
    info "[$role] deployed. 'mrrctl rollback $role' reverts to the previous build."
}

cmd_deploy() {
    [ -x "$DOTNET" ] || die "dotnet not found at $DOTNET"
    [ -d "$REPO" ] || die "repo not found at $REPO"
    local which="${1:-all}"
    case "$which" in
        all) deploy_one game; deploy_one config ;;
        *)   deploy_one "$which" ;;
    esac
}

cmd_update() {
    info "git pull in $REPO"
    git -C "$REPO" pull --ff-only || die "git pull failed"
    cmd_deploy "${1:-all}"
}

cmd_rollback() {
    local role="${1:-game}" paths dir dll unit prev was_active=no
    paths=$(role_paths "$role")
    dir=${paths%%|*};  paths=${paths#*|}
    dll=${paths%%|*};  paths=${paths#*|}
    paths=${paths#*|}; unit=${paths#*|}
    prev="${dir}.previous"

    [ -f "$prev/$dll" ] || die "no previous build in $prev"
    [ "$("$SYSTEMCTL" is-active "$unit")" = "active" ] && was_active=yes
    [ "$was_active" = yes ] && sc stop "$unit"
    info "[$role] restoring $prev -> $dir"
    rm -rf "$dir.rollback-tmp"
    mv "$dir" "$dir.rollback-tmp"
    mv "$prev" "$dir"
    mv "$dir.rollback-tmp" "$prev"
    [ "$was_active" = yes ] && sc start "$unit"
    info "[$role] rolled back (the build you just left is now in $prev)"
}

usage() {
    cat <<'EOF'
mrrctl - Mega Robo Rally process manager

  mrrctl status  [unit]     state, freezer, pid, memory, live health probe
  mrrctl start   [unit]     start it
  mrrctl stop    [unit]     stop it; stays down until started again
  mrrctl restart [unit]     restart it
  mrrctl pause   [unit]     freeze in place (short interruptions only)
  mrrctl resume  [unit]     thaw it
  mrrctl logs [-f] [N]      journal for all mrr-* units
  mrrctl enable | disable   start at boot, or not
  mrrctl list               all MRR units and timers
  mrrctl deploy  [role]     publish Release for a role (default: all)
  mrrctl update  [role]     git pull, then deploy
  mrrctl rollback [role]    restore that role's previous deploy (default: game)

  [unit] defaults to the GAME host, not the whole group. Restarting the editor
  because you restarted the game is harmless; the reverse loses a turn.
  Use 'all' for both hosts.

  Shorthands: game (or server) :5000, config (or editor) :5001,
              health, recover, spi, target.
  Roles for deploy/rollback: game, config, all.
  Tunables live in /etc/default/mrr.
EOF
}

cmd="${1:-status}"; shift || true
case "$cmd" in
    status)   cmd_status  "$@" ;;
    start)    cmd_start   "$@" ;;
    stop)     cmd_stop    "$@" ;;
    restart)  cmd_restart "$@" ;;
    pause)    cmd_pause   "$@" ;;
    resume|unpause|thaw) cmd_resume "$@" ;;
    logs|log) cmd_logs    "$@" ;;
    enable)   cmd_enable  "$@" ;;
    disable)  cmd_disable "$@" ;;
    list|ls)  cmd_list    "$@" ;;
    deploy)   cmd_deploy  "$@" ;;
    update)   cmd_update  "$@" ;;
    rollback) cmd_rollback "$@" ;;
    -h|--help|help) usage ;;
    *) echo "mrrctl: unknown command '$cmd'" >&2; echo; usage; exit 2 ;;
esac
